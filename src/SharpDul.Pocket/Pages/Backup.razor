@page "/backup"
@using SharpDul.Pocket.Localization
@using SharpDul.Pocket.Services
@inject ProgressStore Progress
@inject Localizer Loc

<PageTitle>SharpDul · Backup</PageTitle>

<nav class="top-bar">
    <a href="">@Loc["home"]</a>
</nav>

<h1>@Loc["backup"]</h1>

<section class="card">
    <h2>@Loc["export"]</h2>
    <p>@Loc["exportText"]</p>
    <button class="big-button primary" @onclick="Progress.ExportAsync">@Loc["exportButton"]</button>
</section>

<section class="card">
    <h2>@Loc["import"]</h2>
    <p><strong>@Loc["importText"]</strong></p>
    <label class="big-button file-button">
        @Loc["chooseFile"]
        <InputFile OnChange="ImportAsync" accept=".json,application/json" />
    </label>
    @if (message != null)
    {
        <p class="muted">@Loc[message]</p>
    }
</section>

@code {
    private const long MaxBackupBytes = 5 * 1024 * 1024;

    // Strings key of the result message.
    private string? message;

    private async Task ImportAsync(InputFileChangeEventArgs e)
    {
        try
        {
            using var reader = new StreamReader(e.File.OpenReadStream(MaxBackupBytes));
            string json = await reader.ReadToEndAsync();
            bool imported = await Progress.ImportAsync(json);
            message = imported ? "imported" : "notBackup";
            if (imported)
            {
                // The backup carries its own language.
                await Loc.InitAsync();
            }
        }
        catch (IOException)
        {
            message = "unreadable";
        }
    }
}
