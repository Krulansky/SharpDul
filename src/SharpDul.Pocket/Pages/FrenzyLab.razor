@page "/lab/falling-frenzy"
@using SharpDul.Pocket.Components
@using SharpDul.Pocket.Localization
@using SharpDul.Pocket.Logic
@inject Localizer Loc

<PageTitle>SharpDul · Falling Frenzy Lab</PageTitle>

<nav class="top-bar">
    <a href="course/falling-frenzy/@stage">@Loc["backToCourse"]</a>
    <span class="muted">@Loc["mechanicsLab"] · Falling Frenzy</span>
</nav>

<label class="lab-stage-select">
    @Loc["previewAfterStep"]
    <select value="@stage" @onchange="OnStageChanged">
        @for (int option = 1; option <= 10; option++)
        {
            <option value="@option">@Loc.Format("stepN", option)</option>
        }
    </select>
</label>

<FrenzyGame SceneLevel="@scene.SceneLevel" Features="@scene.Features" />

@code {
    [SupplyParameterFromQuery] public int? Stage { get; set; }

    // Course step N previews stage N (step 11 reuses stage 10).
    private int stage = 10;
    private (int SceneLevel, FrenzyFeature Features) scene = FallingFrenzySim.ForStage(10);

    protected override void OnParametersSet()
    {
        stage = Math.Clamp(Stage ?? 10, 1, 10);
        scene = FallingFrenzySim.ForStage(stage);
    }

    private void OnStageChanged(ChangeEventArgs e)
    {
        if (int.TryParse(e.Value?.ToString(), out int selected))
        {
            stage = Math.Clamp(selected, 1, 10);
            scene = FallingFrenzySim.ForStage(stage);
        }
    }
}
