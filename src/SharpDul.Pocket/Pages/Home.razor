@page "/"
@using SharpDul.Pocket.Localization
@using SharpDul.Pocket.Logic
@using SharpDul.Pocket.Models
@using SharpDul.Pocket.Services
@inject ContentLibrary Content
@inject ProgressStore Progress
@inject CourseLibrary Courses
@inject Localizer Loc

<PageTitle>SharpDul</PageTitle>

<header class="hero">
    <div class="row">
        <h1>SharpDul</h1>
        <div class="lang-switch">
            @foreach (Language language in LanguageInfo.All)
            {
                <button class="@(language == Loc.Current ? "active" : "")" @onclick="() => SetLanguageAsync(language)">@LanguageInfo.Label(language)</button>
            }
        </div>
    </div>
    <p class="muted">@Loc["tagline"]</p>
</header>

@if (progress == null || packs == null)
{
    <p class="muted">@Loc["loading"]</p>
}
else
{
    <section class="card">
        <div class="row">
            <strong>@Loc.Format("level", Progression.GetLevel(progress.Xp))</strong>
            <span class="muted">@progress.Xp XP</span>
        </div>
        <div class="bar"><div class="bar-fill" style="width:@Percent(Progression.GetLevelProgress(progress.Xp))%"></div></div>

        <div class="row days-row">
            <span>@Loc.Format("activeDays", activeDays.Count(active => active), Progression.ActiveDaysWindow)</span>
        </div>
        <div class="days">
            @foreach (bool active in activeDays)
            {
                <span class="day @(active ? "active" : "")"></span>
            }
        </div>
    </section>

    <a class="big-button primary" href="quiz/daily">
        <span>@Loc["daily"]</span>
        <small>@(dueCount == 0 ? Loc["allCaughtUp"] : Loc.Format("cardsDue", dueCount, SessionBuilder.DailySessionSize))</small>
    </a>

    <h2>@Loc["courses"]</h2>
    @foreach (Course course in courses)
    {
        <a class="big-button" href="course/@course.Id">
            <span>@course.Title</span>
            <small>@course.Description</small>
            <small>@Loc.Format("stepsBuilt", course.Steps.Count(step => progress.CompletedSteps.Contains($"{course.Id}/{step.Id}")), course.Steps.Count)</small>
        </a>
    }

    <h2>@Loc["projects"]</h2>
    @foreach (ContentPack pack in packs)
    {
        <a class="big-button" href="quiz/burst/@pack.Id">
            <span>@pack.Title</span>
            <small>@pack.Description</small>
            <small>@Loc.Format("masteredBurst", CountMastered(pack), pack.Questions.Count)</small>
        </a>
    }

    <h2>@Loc["labs"]</h2>
    <a class="big-button" href="build/falling-frenzy">
        <span>@Loc["buildLab"] · Falling Frenzy</span>
        <small>@Loc["buildLabDesc"]</small>
    </a>
    <a class="big-button" href="lab/lander">
        <span>@Loc["mechanicsLab"] · LuaLander</span>
        <small>@Loc["mechanicsLabDesc"]</small>
    </a>
    <a class="big-button" href="lab/falling-frenzy">
        <span>@Loc["mechanicsLab"] · Falling Frenzy</span>
        <small>@Loc["fallingFrenzyLabDesc"]</small>
    </a>
    <a class="big-button" href="lab/combat">
        <span>@Loc["mechanicsLab"] · 2D Combat</span>
        <small>@Loc["combatLabDesc"]</small>
    </a>

    <a class="link-button" href="backup">@Loc["backupLink"]</a>
}

@code {
    [CascadingParameter] public Language Language { get; set; }

    private ProgressData? progress;
    private IReadOnlyList<ContentPack>? packs;
    private IReadOnlyList<Course> courses = Array.Empty<Course>();
    private bool[] activeDays = Array.Empty<bool>();
    private int dueCount;

    protected override async Task OnParametersSetAsync()
    {
        // Runs again when the language changes, to load the translated packs.
        packs = await Content.GetPacksAsync();
        courses = await Courses.GetCoursesAsync();
        progress = await Progress.GetAsync();

        DateOnly today = ProgressStore.Today;
        activeDays = Progression.GetActiveDays(progress, today);
        dueCount = SessionBuilder.CountDue(packs.SelectMany(pack => pack.Questions), progress, today);
    }

    private Task SetLanguageAsync(Language language) => Loc.SetLanguageAsync(language);

    private int CountMastered(ContentPack pack)
    {
        return pack.Questions.Count(question =>
            progress!.Cards.TryGetValue(question.Id, out CardProgress? card) && card.Box >= LeitnerScheduler.MasteredBox);
    }

    private static int Percent(float normalized) => (int)MathF.Round(normalized * 100f);
}
